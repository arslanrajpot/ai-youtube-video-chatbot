# Copy to .env and fill in. The app loads this via python-dotenv (see app.py / services).

# --- LLM (required for "Ask a question" after a transcript is loaded) ---
# Get a key at https://console.groq.com/
GROQ_API_KEY=

# Optional (Gemini / Google embeddings in RAG)
# GOOGLE_API_KEY=

# --- YouTube: optional browser cookies (Netscape cookies.txt) ---
# Helps when YouTube returns 403 for audio download (yt-dlp) or blocks transcript fetches.
# Export from your browser (e.g. a "cookies.txt" extension), then:
# YOUTUBE_COOKIEFILE=C:\path\to\cookies.txt
# YTDLP_COOKIEFILE=C:\path\to\cookies.txt
#
# You can set one file for both, or only one.

# --- Debug JSON errors (app.py) ---
# YOUTUBE_CHATBOT_DEBUG=0
